# Пример конфигурации. Скопируйте в `.env` и при необходимости поправьте.
# На проде те же ключи обычно задаются на сервере; локально подхватываются из `.env`.

APP_ENV=dev
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./data/livingbraiding.db

LB_TECHSPEC_USERNAME=techspec
LB_TECHSPEC_PASSWORD=techspec
LB_TECHSPEC_DISPLAY_NAME=Техспец

# Пусто / 0 / false — выкл. Для локальной демо-начинки: ENABLE_DEV_SEED=1
ENABLE_DEV_SEED=
ENABLE_PROD_SEED=

# Пусто — очистка аудита включена. 1/true/yes — отключить.
DISABLE_AUDIT_RETENTION=
# Месяцев хранения аудита (если пусто — из настроек БД или 6).
AUDIT_RETENTION_MONTHS=6

LB_MEDIA_ROOT=data/uploads
PAYROLL_LEDGER_BACKFILL_CLOSED=false
# Локально часто 8010; start_uvicorn.sh / App Platform — обычно 8080.
PORT=8080

# Уведомления мастерам (MVP). Токены не коммитить; без них process_outbox пишет failed.
TELEGRAM_BOT_TOKEN=
# Username бота без @ (для ссылки t.me/...?start=).
TELEGRAM_BOT_USERNAME=
# Секрет setWebhook secret_token; если задан — обязателен заголовок X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# VK Callback API (основной канал на проде, если Telegram недоступен).
VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_CONFIRMATION_CODE=
VK_SECRET_KEY=
VK_API_VERSION=5.199
# Короткое имя сообщества для https://vk.me/<domain>?ref=<код> (club123 или screen name).
VK_GROUP_DOMAIN=

# Фоновый воркер outbox (вместо cron). По умолчанию: true при APP_ENV=prod, иначе false.
NOTIFICATION_WORKER_ENABLED=
# Интервал тика воркера, секунды (по умолчанию 45).
NOTIFICATION_WORKER_INTERVAL_SECONDS=45
